# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Ключи приложения с https://my.telegram.org (обязательно)
TG_API_ID=
TG_API_HASH=

# Прокси для подключения к Telegram (опционально; пусто — без прокси)
TG_PROXY_HOST=
TG_PROXY_PORT=1080
TG_PROXY_TYPE=http
TG_PROXY_USER=
TG_PROXY_PASS=

# Адрес веб-сервера
HOST=127.0.0.1
PORT=8000

# Дополнительные разрешённые origin'ы для API через запятую (по умолчанию только сам сервер)
TG_CORS_ORIGINS=
