     "pt": "Microdistorção",
     "uk": "Мікро-спотворення"
    },
    "default": 0,
    "min": 0,
    "max": 1,
    "step": 0.01
   },
   {
    "key": "zRadius",
    "type": "number",
    "title": {
     "ru": "Глубина фаски",
     "en": "Bevel depth",
     "es": "Profundidad del bisel",
     "pt": "Profundidade do chanfro",
