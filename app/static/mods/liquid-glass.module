    "type": "switch",
    "title": {
     "ru": "Карточки и группы (тяжелее)",
     "en": "Cards and groups (heavier)",
     "es": "Tarjetas y grupos (más pesado)",
     "pt": "Cartões e grupos (mais pesado)",
     "uk": "Картки та групи (важче)"
    },
    "default": true
   },
   {
    "key": "refraction",
    "type": "number",
    "title": {
