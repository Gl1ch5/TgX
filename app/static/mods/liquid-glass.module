    "type": "number",
    "title": {
     "ru": "Насыщенность",
     "en": "Saturation",
     "es": "Saturación",
     "pt": "Saturação",
     "uk": "Насиченість"
    },
    "default": 0,
    "min": -1,
    "max": 1,
    "step": 0.01
   },
   {
    "key": "tintStrength",
    "type": "number",
    "title": {
     "ru": "Холодный оттенок",
     "en": "Cool tint",
     "es": "Matiz frío",
     "pt": "Tom frio",
     "uk": "Холодний відтінок"
    },
    "default": 0,
    "min": 0,
    "max": 1,
    "step": 0.01
   },
   {
    "key": "brightness",
    "type": "number",
    "title": {
     "ru": "Яркость",
     "en": "Brightness",
     "es": "Brillo",
     "pt": "Brilho",
     "uk": "Яскравість"
    },
