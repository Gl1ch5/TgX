    "max": 1,
    "step": 0.01
   },
   {
    "key": "distortion",
    "type": "number",
    "title": {
     "ru": "Микро-искажение",
     "en": "Micro-distortion",
     "es": "Microdistorsión",
     "pt": "Microdistorção",
     "uk": "Мікро-спотворення"
    },
    "default": 0,
    "min": 0,
    "max": 1,
    "step": 0.01
   },
   {
    "key": "zRadius",
    "type": "number",
    "title": {
     "ru": "Глубина фаски",
     "en": "Bevel depth",
     "es": "Profundidad del bisel",
     "pt": "Profundidade do chanfro",
     "uk": "Глибина фаски"
    },
    "default": 40,
