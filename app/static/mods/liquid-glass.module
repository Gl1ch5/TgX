   },
   {
    "key": "shadowOffsetY",
    "type": "number",
    "title": {
     "ru": "Тень, смещение по Y",
     "en": "Shadow offset Y",
     "es": "Desplazamiento Y de sombra",
     "pt": "Deslocamento Y da sombra",
