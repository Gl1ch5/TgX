     "en": "Accent colour",
     "es": "Color de acento",
     "pt": "Cor de destaque",
     "uk": "Акцентний колір"
    },
    "default": "#0a84ff"
   },
   {
    "key": "cardTint",
    "type": "number",
    "title": {
