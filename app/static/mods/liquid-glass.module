   },
   {
    "key": "chromAberration",
    "type": "number",
    "title": {
     "ru": "Хроматическая аберрация",
     "en": "Chromatic aberration",
     "es": "Aberración cromática",
     "pt": "Aberração cromática",
     "uk": "Хроматична аберація"
    },
    "default": 0.05,
    "min": 0,
    "max": 1,
    "step": 0.01
   },
   {
