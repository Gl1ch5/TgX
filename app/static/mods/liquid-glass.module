{
 "manifest": {
  "id": "liquid-glass",
  "name": {
   "ru": "Жидкое стекло",
   "en": "Liquid Glass",
   "es": "Cristal líquido",
   "pt": "Vidro líquido",
   "uk": "Рідке скло"
  },
  "version": "1.2.0",
  "author": "TeleX",
  "icon": "mods/icons/liquid-glass.svg",
  "description": {
   "ru": "Реалистичное стекло с преломлением, хроматической аберрацией и бликами — как в liquidglass",
   "en": "Realistic glass with refraction, chromatic aberration and highlights — the liquidglass look",
   "es": "Cristal realista con refracción, aberración cromática y reflejos — el aspecto de liquidglass",
   "pt": "Vidro realista com refração, aberração cromática e reflexos — o visual do liquidglass",
   "uk": "Реалістичне скло з заломленням, хроматичною аберацією та відблисками — як у liquidglass"
  },
  "about": {
   "ru": "Переделывает весь интерфейс в стекло: панели, поиск, вкладки, меню и диалоги получают преломление и блики по формулам шейдера библиотеки github.com/ybouane/liquidglass, а карточки, пузыри, группы настроек, кнопки и чипы — стеклянный вид (размытие, подсветка кромки, тени). Меняется и акцентный цвет всего приложения.\nКарточки и группы получают настоящее преломление по краям (только те, что рядом с экраном — для скорости); выключить можно в настройках мода. Фон остаётся живым при прокрутке. Работает в браузерах на Chromium (Chrome, Edge, приложения Android и Windows).",
   "en": "Turns the whole interface into glass: bars, search, tabs, menus and dialogs get refraction and highlights from the shader maths of github.com/ybouane/liquidglass, while cards, bubbles, settings groups, buttons and chips get the glass look (blur, rim light, shadows). The accent colour of the whole app changes too.\nThe backdrop stays live while you scroll. Works in Chromium-based browsers (Chrome, Edge, the Android and Windows apps).",
   "es": "Convierte toda la interfaz en cristal: barras, búsqueda, pestañas, menús y diálogos reciben refracción y reflejos con las fórmulas del shader de github.com/ybouane/liquidglass; tarjetas, burbujas, grupos de ajustes, botones y chips reciben el aspecto de cristal (desenfoque, luz de borde, sombras). También cambia el color de acento de toda la app.\nEl fondo sigue vivo al desplazarse. Funciona en navegadores Chromium (Chrome, Edge, apps de Android y Windows).",
   "pt": "Transforma toda a interface em vidro: barras, busca, abas, menus e diálogos recebem refração e reflexos com as fórmulas do shader de github.com/ybouane/liquidglass; cartões, balões, grupos de configurações, botões e chips ganham o visual de vidro (desfoque, luz de borda, sombras). A cor de destaque de todo o app também muda.\nO fundo continua vivo ao rolar. Funciona em navegadores Chromium (Chrome, Edge, apps de Android e Windows).",
   "uk": "Перетворює увесь інтерфейс на скло: панелі, пошук, вкладки, меню й діалоги отримують заломлення та відблиски за формулами шейдера github.com/ybouane/liquidglass, а картки, бульбашки, групи налаштувань, кнопки й чипи — скляний вигляд (розмиття, підсвітка кромки, тіні). Змінюється й акцентний колір усього застосунку.\nТло лишається живим під час прокручування. Працює в браузерах на Chromium (Chrome, Edge, застосунки для Android і Windows)."
  },
  "tags": [
   "theme",
   "glass",
   "webgl-look"
  ],
  "settings": [
   {
    "key": "skin",
    "type": "switch",
    "title": {
     "ru": "Перекрасить всё приложение",
     "en": "Restyle the whole app",
     "es": "Rediseñar toda la app",
     "pt": "Redesenhar todo o app",
     "uk": "Перефарбувати весь застосунок"
    },
    "default": true
   },
   {
    "key": "accent",
    "type": "color",
    "title": {
     "ru": "Акцентный цвет",
     "en": "Accent colour",
