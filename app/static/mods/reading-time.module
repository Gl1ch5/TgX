// @manifest {"id":"reading-time","name":"Reading time","version":"1.0.0","author":"TeleX","icon":"⏱️","description":"Shows how long a post takes to read","about":"Adds a small “≈ 2 min” chip to long posts in the feed. Set your reading speed and the shortest post that gets a chip.","tags":["feed","posts"],"settings":[{"key":"wpm","type":"number","title":"Reading speed, words per minute","default":200,"min":100,"max":400,"step":10},{"key":"min","type":"number","title":"Only for posts longer than (words)","default":60,"min":0,"max":300,"step":10}]}
export default function (tx) {
  const mark = (card) => {
    card.querySelectorAll('.rt-chip').forEach((n) => n.remove());
    const text = card.querySelector('.post-text');
    if (!text) return;
    const words = (text.textContent || '').trim().split(/\s+/).filter(Boolean).length;
    if (words < tx.config.get('min')) return;
    const mins = Math.max(1, Math.round(words / tx.config.get('wpm')));
    const chip = document.createElement('div');
    chip.className = 'rt-chip';
    chip.textContent = '⏱ ≈ ' + mins + ' ' + (tx.t('мин') === 'мин' ? 'мин' : 'min');
    chip.style.cssText = 'display:inline-block;margin:4px 0 2px;padding:2px 9px;border-radius:999px;font-size:12.5px;background:var(--tx-accent-soft);color:var(--tx-accent)';
    text.prepend(chip);
  };
  tx.ui.watch('[id^="post-card-"]', mark);
  tx.config.on('*', () => document.querySelectorAll('[id^="post-card-"]').forEach(mark));
}
